{
    "name": "@squide/firefly-rsbuild-configs",
    "version": "3.0.3",
    "description": "Rsbuild configuration helpers for the Squide firefly technology stack.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-squide.git",
        "directory": "packages/firefly-rsbuild-configs"
    },
    "files": [
        "src",
        "dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "dev": "rslib build --watch --config ./rslib.dev.ts",
        "build": "rslib build --config ./rslib.build.ts",
        "typecheck": "tsc",
        "test": "vitest --config vitest.config.ts --no-watch"
    },
    "dependencies": {
        "@module-federation/enhanced": "2.9.3",
        "@module-federation/rsbuild-plugin": "2.9.3",
        "@workleap/rsbuild-configs": "^5.1.1",
        "deepmerge": "^4.3.1",
        "semver": "^7.8.6"
    },
    "devDependencies": {
        "@rsbuild/core": "2.3.1",
        "@rslib/core": "1.0.6",
        "@rspack/core": "2.3.1",
        "@types/node": "26.6.6",
        "@types/semver": "7.8.0",
        "@workleap/rslib-configs": "2.1.1",
        "@workleap/typescript-configs": "5.1.0",
        "typescript": "7.0.2",
        "vitest": "5.1.0"
    },
    "peerDependencies": {
        "@rsbuild/core": "^2.3.1",
        "@rspack/core": "^2.3.1"
    }
}
