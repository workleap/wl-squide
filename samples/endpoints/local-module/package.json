{
    "name": "@endpoints/local-module",
    "version": "0.0.0",
    "private": true,
    "description": "Local module to showcase Squide.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "type": "module",
    "exports": "./src/register.tsx",
    "scripts": {
        "postinstall": "pnpm msw init",
        "dev-isolated": "cross-env USE_MSW=true ISOLATED=true rsbuild dev --config rsbuild.dev.ts",
        "build-isolated": "cross-env USE_MSW=true ISOLATED=true rsbuild build --config rsbuild.build.ts",
        "serve-build-isolated": "pnpm http-server dist -p 8080 -P http://localhost:8080? -c-1",
        "typecheck": "tsc"
    },
    "dependencies": {
        "@endpoints/i18next": "workspace:*",
        "@endpoints/layouts": "workspace:*",
        "@endpoints/shared": "workspace:*",
        "@endpoints/shell": "workspace:*",
        "@squide/fakes": "workspace:*",
        "@squide/firefly": "workspace:*",
        "@squide/i18next": "workspace:*",
        "@workleap/logging": "^2.1.2"
    },
    "devDependencies": {
        "@rsbuild/core": "2.3.3",
        "@rspack/core": "2.3.3",
        "@tanstack/react-query": "5.108.0",
        "@tanstack/react-query-devtools": "5.108.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@workleap/browserslist-config": "3.1.0",
        "@workleap/rsbuild-configs": "5.1.3",
        "@workleap/typescript-configs": "5.2.1",
        "browserslist": "4.29.6",
        "cross-env": "10.1.0",
        "http-server": "14.1.1",
        "i18next": "27.1.5",
        "msw": "3.0.6",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-i18next": "18.0.2",
        "typescript": "7.0.2"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5.108.0",
        "i18next": "^27.1.5",
        "msw": "^3.0.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^18.0.2"
    },
    "msw": {
        "workerDirectory": "public"
    }
}
