{
    "name": "@squide/msw",
    "version": "5.0.0",
    "description": "Add support for MSW to @squide application shell.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-squide.git",
        "directory": "packages/msw"
    },
    "files": [
        "src",
        "dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts",
        "./internal": "./src/internal.ts"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./internal": {
                "types": "./dist/internal.d.ts",
                "import": "./dist/internal.js",
                "default": "./dist/internal.js"
            }
        },
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "rslib build --config ./rslib.build.ts",
        "typecheck": "tsgo",
        "test": "vitest --config vitest.config.ts --no-watch"
    },
    "dependencies": {
        "@squide/core": "workspace:^",
        "@workleap/logging": "^2.0.1"
    },
    "devDependencies": {
        "@rsbuild/core": "2.2.14",
        "@rslib/core": "1.0.3",
        "@types/node": "26.6.5",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@vitejs/plugin-react": "6.1.2",
        "@workleap/rslib-configs": "2.0.0",
        "@workleap/typescript-configs": "5.0.0",
        "happy-dom": "21.0.4",
        "typescript": "6.0.3",
        "vitest": "5.0.5"
    },
    "peerDependencies": {
        "msw": "^3.0.3"
    }
}
