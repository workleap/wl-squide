{
    "name": "@squide/i18next",
    "version": "3.0.1",
    "description": "Add support for i18next to @squide application shell.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-squide.git",
        "directory": "packages/i18next"
    },
    "files": [
        "src",
        "dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": "./src/index.ts",
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            }
        },
        "access": "public",
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "rslib build --config ./rslib.build.ts",
        "typecheck": "tsgo",
        "test": "vitest --config vitest.config.ts --no-watch"
    },
    "dependencies": {
        "@formatjs/intl-localematcher": "^0.9.0",
        "@squide/core": "workspace:^"
    },
    "devDependencies": {
        "@rsbuild/core": "2.2.14",
        "@rslib/core": "1.0.3",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@workleap/logging": "2.0.1",
        "@workleap/rslib-configs": "2.0.0",
        "@workleap/typescript-configs": "5.0.0",
        "typescript": "7.0.2",
        "vitest": "5.0.5"
    },
    "peerDependencies": {
        "i18next": "^26.5.3",
        "i18next-browser-languagedetector": "^8.2.1",
        "react": "^18.0.0 || ^19.0.0",
        "react-i18next": "^17.1.0"
    }
}
