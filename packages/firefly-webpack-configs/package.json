{
    "name": "@squide/firefly-webpack-configs",
    "version": "5.2.16",
    "description": "Webpack configuration helpers for the Squide firefly technology stack.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-squide.git",
        "directory": "packages/firefly-webpack-configs"
    },
    "files": [
        "src",
        "dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "dev": "rslib build --watch --config ./rslib.dev.ts",
        "build": "rslib build --config ./rslib.build.ts",
        "typecheck": "tsc",
        "test": "vitest --config vitest.config.ts --no-watch"
    },
    "dependencies": {
        "@module-federation/enhanced": "2.9.3",
        "@workleap/webpack-configs": "1.6.16",
        "deepmerge": "^4.3.1",
        "html-webpack-plugin": "^5.6.8",
        "semver": "^7.8.6"
    },
    "devDependencies": {
        "@rsbuild/core": "2.3.1",
        "@rslib/core": "1.0.6",
        "@types/node": "26.6.6",
        "@types/semver": "7.8.0",
        "@workleap/rslib-configs": "2.1.1",
        "@workleap/typescript-configs": "5.1.0",
        "typescript": "7.0.2",
        "vitest": "5.1.0",
        "webpack": "5.110.3",
        "webpack-dev-server": "5.2.4"
    },
    "peerDependencies": {
        "@swc/core": "^1.16.22",
        "@swc/helpers": "^0.5.24",
        "@workleap/swc-configs": "^2.3.16",
        "browserslist": "^4.29.5",
        "postcss": "^8.5.26",
        "webpack": ">=5.110.3 <5.112.0",
        "webpack-dev-server": "^5.2.4"
    }
}
