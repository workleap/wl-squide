{
    "name": "@basic-webpack/remote-module",
    "version": "0.0.0",
    "private": true,
    "description": "Remote module to showcase Squide.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "type": "module",
    "scripts": {
        "dev": "webpack serve --config webpack.dev.js",
        "dev-isolated": "cross-env ISOLATED=true pnpm dev",
        "build": "webpack --config webpack.build.js",
        "serve-build": "pnpm http-server dist -p 8087 -P http://localhost:8087? -c-1",
        "typecheck": "tsc"
    },
    "dependencies": {
        "@basic-webpack/shared": "workspace:*",
        "@basic-webpack/shell": "workspace:*",
        "@react-aria/toast": "3.1.1",
        "@react-stately/toast": "3.2.1",
        "@squide/fakes": "workspace:*",
        "@squide/firefly": "workspace:*",
        "@workleap/logging": "2.1.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router": "8.5.1",
        "useless-lib": "^2.1.0"
    },
    "devDependencies": {
        "@squide/firefly-webpack-configs": "workspace:*",
        "@swc/core": "1.16.22",
        "@swc/helpers": "0.5.24",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@workleap/browserslist-config": "3.1.0",
        "@workleap/swc-configs": "2.3.16",
        "@workleap/typescript-configs": "5.1.0",
        "browserslist": "4.29.5",
        "cross-env": "10.1.0",
        "http-server": "14.1.1",
        "typescript": "7.0.2",
        "webpack": "5.112.2",
        "webpack-cli": "7.3.1",
        "webpack-dev-server": "6.1.0"
    }
}
