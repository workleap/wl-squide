        "express": "5.3.0"
    },
    "devDependencies": {
        "@types/cors": "2.8.19",
        "@types/express": "5.0.6",
        "@types/node": "26.6.5",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@workleap/typescript-configs": "5.0.0",
        "tsx": "4.23.15",
        "typescript": "6.0.3"
