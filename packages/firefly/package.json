{
    "name": "@squide/firefly",
    "version": "20.1.3",
    "description": "Squide bundle for the firefly technology stack.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-squide.git",
        "directory": "packages/firefly"
    },
    "files": [
        "src",
        "dist",
        "skills",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts",
        "./internal": "./src/internal.ts",
        "./testing": "./src/testing/index.ts",
        "./tests": "./tests/utils.ts"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./internal": {
                "types": "./dist/internal.d.ts",
                "import": "./dist/internal.js",
                "default": "./dist/internal.js"
            },
            "./testing": {
                "types": "./dist/testing/index.d.ts",
                "import": "./dist/testing/index.js",
                "default": "./dist/testing/index.js"
            }
        },
        "access": "public",
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "prepack": "node ./scripts/agent-skill.mjs copy",
        "postpack": "node ./scripts/agent-skill.mjs clean",
        "build": "rslib build --config ./rslib.build.ts",
        "typecheck": "tsc",
        "test": "vitest --config vitest.config.ts --no-watch"
    },
    "dependencies": {
        "@squide/core": "workspace:^",
        "@squide/env-vars": "workspace:^",
        "@squide/launch-darkly": "workspace:^",
        "@squide/msw": "workspace:^",
        "@squide/react-router": "workspace:^",
        "@workleap-telemetry/core": "^2.0.6",
        "@workleap/logging": "^2.1.0",
        "uuid": "^14.0.3"
    },
    "devDependencies": {
        "@rsbuild/core": "2.3.1",
        "@rslib/core": "1.0.6",
        "@testing-library/react": "16.3.3",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.2.1",
        "@workleap/rslib-configs": "2.1.1",
        "@workleap/typescript-configs": "5.1.0",
        "happy-dom": "21.0.4",
        "typescript": "7.0.2",
        "vitest": "5.1.0"
    },
    "peerDependencies": {
        "@opentelemetry/api": "^1.9.1",
        "@tanstack/react-query": "^5.107.1",
        "@types/react": "^18.0.0 || ^19.0.0",
        "launchdarkly-js-client-sdk": "^3.9.6",
        "msw": "^3.0.4",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0",
        "react-router": "^8.5.1"
    },
    "peerDependenciesMeta": {
        "@opentelemetry/api": {
            "optional": true
        },
        "@types/react": {
            "optional": true
        }
    }
}
