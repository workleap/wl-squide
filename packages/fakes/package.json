{
    "name": "@squide/fakes",
    "version": "2.2.23",
    "description": "Fake implementations to facilitate the development of modules in isolation with @squide.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-squide.git",
        "directory": "packages/fakes"
    },
    "files": [
        "src",
        "dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": "./src/index.ts",
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            }
        },
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "rslib build --config ./rslib.build.ts",
        "typecheck": "tsc"
    },
    "dependencies": {
        "@squide/core": "workspace:^"
    },
    "devDependencies": {
        "@rsbuild/core": "2.3.1",
        "@rslib/core": "1.0.6",
        "@types/node": "26.6.6",
        "@workleap/rslib-configs": "2.1.1",
        "@workleap/typescript-configs": "5.1.0",
        "typescript": "7.0.2"
    }
}
