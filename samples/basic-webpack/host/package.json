{
    "name": "@basic-webpack/host",
    "version": "0.0.0",
    "private": true,
    "description": "Host application to showcase Squide.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "type": "module",
    "scripts": {
        "dev": "webpack serve --config webpack.dev.js",
        "build": "pnpm build:webpack && pnpm build:copy-redirects",
        "build:webpack": "webpack --config webpack.build.js",
        "build:copy-redirects": "copyfiles _redirects dist",
        "build:copy-public-files": "copyfiles -u 1 public/favicon.png dist",
        "serve-build": "pnpm http-server dist -p 8086 -P http://localhost:8086? -c-1",
        "typecheck": "tsc"
    },
    "dependencies": {
        "@basic-webpack/local-module": "workspace:*",
        "@basic-webpack/shared": "workspace:*",
        "@basic-webpack/shell": "workspace:*",
        "@react-aria/toast": "3.1.1",
        "@react-stately/toast": "3.2.1",
        "@squide/fakes": "workspace:*",
        "@squide/firefly": "workspace:*",
        "@squide/firefly-module-federation": "workspace:*",
        "@tanstack/react-query": "5.107.1",
        "@workleap/logging": "2.1.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router": "8.5.1",
        "useless-lib": "^2.0.0"
    },
    "devDependencies": {
        "@squide/firefly-webpack-configs": "workspace:*",
        "@swc/core": "1.16.22",
        "@swc/helpers": "0.5.24",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@workleap/browserslist-config": "3.1.0",
        "@workleap/swc-configs": "2.3.16",
        "@workleap/typescript-configs": "5.1.0",
        "browserslist": "4.29.5",
        "copyfiles": "2.4.1",
        "http-server": "14.1.1",
        "typescript": "7.0.2",
        "webpack": "5.110.3",
        "webpack-cli": "7.3.1",
        "webpack-dev-server": "5.2.4"
    }
}
