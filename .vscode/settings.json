{
    "search.exclude": {
        "**/node_modules*": true,
        "**/dist*": true
    },

    // Formatting and linting are handled by oxfmt and oxlint through the oxc extension.
    "oxc.typeAware": true,
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
        "source.format.oxc": "always",
        "source.fixAll.oxc": "always"
    },
    "[html]": {
        "editor.formatOnSave": false
    },

    // Languages
    "typescript.preferences.useAliasesForRenames": false,
    "typescript.tsdk": "node_modules\\typescript\\lib",

    // "typescript.experimental.useTsgo": true,
    // "typescript.tsdk": "node_modules\\@typescript\\native-preview\\lib",

    "javascript.preferences.useAliasesForRenames": false,

    "css.validate": false, // Disables the default validation to use Stylelint instead

    // Settings for third parties that are frequently used
    "files.associations": {
        "*.snap": "javascriptreact",
        "turbo.json": "jsonc"
    },

    "github.copilot.chat.commitMessageGeneration.instructions": [
        {
            "file": ".github/copilot/commit-message-instructions.md"
        }
    ],

    "chat.useAgentSkills": true,

    "json.schemas": [
        {
            "fileMatch": ["chromatic.config.json"],
            "url": "https://www.chromatic.com/config-file.schema.json"
        }
    ]
}
