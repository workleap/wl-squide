{
    "name": "@squide/fakes",
    "author": "Workleap",
    "version": "2.2.23",
    "description": "Fake implementations to facilitate the development of modules in isolation with @squide.",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-squide.git",
        "directory": "packages/fakes"
    },
    "type": "module",
    "publishConfig": {
        "access": "public",
        "provenance": true,
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            }
        }
    },
    "exports": "./src/index.ts",
    "files": [
        "src",
        "dist",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "rslib build --config ./rslib.build.ts",
        "typecheck": "tsgo"
    },
    "dependencies": {
        "@squide/core": "workspace:^"
    },
    "devDependencies": {
        "@rsbuild/core": "2.2.14",
        "@rslib/core": "1.0.3",
        "@types/node": "26.6.5",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@workleap/rslib-configs": "2.0.0",
        "@workleap/typescript-configs": "5.0.0",
        "typescript": "6.0.3"
    },
    "sideEffects": false
}
