{
    "name": "@basic-webpack/another-remote-module",
    "version": "0.0.0",
    "private": true,
    "description": "Another remote module to showcase Squide.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "type": "module",
    "scripts": {
        "dev": "webpack serve --config webpack.dev.js",
        "dev-isolated": "cross-env ISOLATED=true pnpm dev",
        "build": "webpack --config webpack.build.js",
        "serve-build": "pnpm http-server dist -p 8088 -P http://localhost:8088? -c-1",
        "typecheck": "tsgo"
    },
    "dependencies": {
        "@basic-webpack/shared": "workspace:*",
        "@basic-webpack/shell": "workspace:*",
        "@react-aria/toast": "3.1.1",
        "@react-stately/toast": "3.2.1",
        "@squide/fakes": "workspace:*",
        "@squide/firefly": "workspace:*",
        "@workleap/logging": "2.0.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router": "8.5.0",
        "useless-lib": "3.0.0"
    },
    "devDependencies": {
        "@squide/firefly-webpack-configs": "workspace:*",
        "@swc/core": "1.16.18",
        "@swc/helpers": "0.5.23",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@workleap/browserslist-config": "3.0.0",
        "@workleap/swc-configs": "2.3.15",
        "@workleap/typescript-configs": "5.0.0",
        "browserslist": "4.29.4",
        "cross-env": "10.1.0",
        "http-server": "14.1.1",
        "typescript": "7.0.2",
        "webpack": "5.110.3",
        "webpack-cli": "7.2.3",
        "webpack-dev-server": "5.2.4"
    }
}
