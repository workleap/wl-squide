{
    "name": "@storybook/host",
    "version": "0.0.0",
    "private": true,
    "description": "ShareGate Home application",
    "license": "Apache-2.0",
    "author": "Workleap",
    "type": "module",
    "scripts": {
        "postinstall": "pnpm msw init",
        "dev": "rsbuild dev --config rsbuild.dev.ts",
        "build": "rsbuild build --config rsbuild.build.ts",
        "serve-build": "pnpm http-server dist/app -p 8081 -P http://localhost:8081? -c-1 --cors",
        "typecheck": "tsc"
    },
    "dependencies": {
        "@opentelemetry/api": "1.9.1",
        "@squide/firefly": "workspace:*",
        "@tanstack/react-query": "5.104.5",
        "launchdarkly-js-client-sdk": "3.9.6",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router": "8.5.0"
    },
    "devDependencies": {
        "@rsbuild/core": "2.2.14",
        "@rslib/core": "1.0.3",
        "@rspack/core": "2.2.9",
        "@squide/firefly-storybook": "workspace:*",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@workleap/browserslist-config": "3.0.0",
        "@workleap/rsbuild-configs": "5.0.0",
        "@workleap/stylelint-configs": "2.1.13",
        "@workleap/typescript-configs": "5.0.0",
        "http-server": "14.1.1",
        "msw": "3.0.3",
        "storybook": "10.6.3",
        "storybook-react-rsbuild": "3.6.1",
        "stylelint": "17.16.0",
        "typescript": "7.0.2"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
