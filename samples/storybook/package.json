{
    "name": "@storybook/app",
    "version": "0.0.0",
    "private": true,
    "description": "Sample to showcase how Squide integrates with Storybook",
    "type": "module",
    "scripts": {
        "postinstall": "pnpm msw init",
        "dev": "storybook dev -p 6006 --disable-telemetry",
        "build": "storybook build --disable-telemetry",
        "serve-build": "pnpm http-server storybook-static -p 8080 -P http://localhost:8080? -c-1",
        "typecheck": "tsc",
        "doctor": "storybook doctor"
    },
    "dependencies": {
        "@storybook/addon-a11y": "10.6.6",
        "msw": "3.0.4",
        "msw-storybook-addon": "3.0.3",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router": "8.5.1",
        "storybook": "10.6.6",
        "storybook-react-rsbuild": "3.6.2"
    },
    "devDependencies": {
        "@rsbuild/core": "2.3.1",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@workleap/rsbuild-configs": "5.1.1",
        "@workleap/typescript-configs": "5.1.0",
        "http-server": "14.1.1",
        "typescript": "7.0.2"
    },
    "msw": {
        "workerDirectory": [
            ".storybook/public"
        ]
    }
}
