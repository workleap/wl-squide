{
    "name": "@squide/firefly-rsbuild-configs",
    "version": "3.0.0",
    "description": "Rsbuild configuration helpers for the Squide firefly technology stack.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-squide.git",
        "directory": "packages/firefly-rsbuild-configs"
    },
    "files": [
        "src",
        "dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "dev": "rslib build --watch --config ./rslib.dev.ts",
        "build": "rslib build --config ./rslib.build.ts",
        "typecheck": "tsgo",
        "test": "vitest --config vitest.config.ts --no-watch"
    },
    "dependencies": {
        "@module-federation/enhanced": "2.9.2",
        "@module-federation/rsbuild-plugin": "2.9.2",
        "@workleap/rsbuild-configs": "^5.0.0",
        "deepmerge": "^4.3.1",
        "semver": "^7.8.5"
    },
    "devDependencies": {
        "@rsbuild/core": "2.2.14",
        "@rslib/core": "1.0.3",
        "@rspack/core": "2.2.9",
        "@types/node": "26.6.5",
        "@types/semver": "7.8.0",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@workleap/rslib-configs": "2.0.0",
        "@workleap/typescript-configs": "5.0.0",
        "typescript": "7.0.2",
        "vitest": "5.0.5"
    },
    "peerDependencies": {
        "@rsbuild/core": "^2.2.14",
        "@rspack/core": "^2.2.9"
    }
}
