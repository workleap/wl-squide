{
    "name": "@squide/firefly-module-federation",
    "version": "4.0.0",
    "description": "Add support for Module Federation to Squide firefly.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-squide.git",
        "directory": "packages/firefly-module-federation"
    },
    "files": [
        "src",
        "dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": "./src/index.ts",
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            }
        },
        "access": "public",
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "rslib build --config ./rslib.build.ts",
        "typecheck": "tsc",
        "test": "vitest --config vitest.config.ts --no-watch"
    },
    "dependencies": {
        "@module-federation/enhanced": "2.9.3",
        "@rspack/core": "^2.3.1",
        "@squide/core": "workspace:^",
        "@squide/firefly": "workspace:^",
        "@workleap/logging": "^2.1.0"
    },
    "devDependencies": {
        "@rsbuild/core": "2.3.1",
        "@rslib/core": "1.0.6",
        "@testing-library/react": "16.3.3",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.2.1",
        "@workleap/rslib-configs": "2.1.1",
        "@workleap/typescript-configs": "5.1.0",
        "happy-dom": "21.0.4",
        "typescript": "7.0.2",
        "vitest": "5.1.0"
    },
    "peerDependencies": {
        "@opentelemetry/api": "^1.9.1",
        "@tanstack/react-query": "^5.107.1",
        "msw": "^3.0.4",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0",
        "react-router": "^8.5.1"
    }
}
