{
    "name": "@storybook/host",
    "description": "ShareGate Home application",
    "private": true,
    "author": "Workleap",
    "version": "0.0.0",
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
        "postinstall": "pnpm msw init",
        "dev": "rsbuild dev --config rsbuild.dev.ts",
        "build": "rsbuild build --config rsbuild.build.ts",
        "serve-build": "pnpm http-server dist/app -p 8081 -P http://localhost:8081? -c-1 --cors",
        "eslint": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint",
        "typecheck": "tsgo"
    },
    "dependencies": {
        "@opentelemetry/api": "1.10.0",
        "@squide/firefly": "workspace:*",
        "@tanstack/react-query": "5.105.0",
        "launchdarkly-js-client-sdk": "3.9.6",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router": "8.5.0"
    },
    "devDependencies": {
        "@eslint/js": "9.39.2",
        "@rsbuild/core": "2.2.14",
        "@rslib/core": "1.0.4",
        "@rspack/core": "2.2.9",
        "@squide/firefly-storybook": "workspace:*",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@typescript-eslint/parser": "8.72.0",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@workleap/browserslist-config": "3.1.0",
        "@workleap/eslint-configs": "2.1.1",
        "@workleap/rsbuild-configs": "5.1.0",
        "@workleap/stylelint-configs": "2.2.0",
        "@workleap/typescript-configs": "5.1.0",
        "eslint": "9.39.2",
        "http-server": "14.1.1",
        "msw": "3.0.3",
        "storybook": "10.6.4",
        "storybook-react-rsbuild": "3.6.1",
        "stylelint": "17.16.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.54.0"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
