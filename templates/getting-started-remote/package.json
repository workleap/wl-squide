{
    "name": "@getting-started-remote/root",
    "version": "0.0.0",
    "private": true,
    "description": "A template for the getting-started guide of Squide.",
    "author": "Workleap",
    "type": "module",
    "scripts": {
        "dev": "pnpm -r --parallel dev",
        "build": "pnpm -r --parallel build",
        "lint": "pnpm run \"/^lint:.*/\"",
        "lint:oxlint": "oxlint --deny-warnings",
        "lint:oxfmt": "oxfmt --check",
        "format": "oxfmt",
        "lint:types": "pnpm -r --parallel --include-workspace-root exec tsc",
        "lint:syncpack": "syncpack lint",
        "list-outdated-deps": "pnpm outdated -r --format list",
        "update-outdated-deps": "pnpm run --sequential \"/^update-outdated-deps:.*/\"",
        "update-outdated-deps:update-versions": "pnpm update -r --latest",
        "update-outdated-deps:update-peers": "syncpack fix-mismatches",
        "clean": "pnpm -r --parallel --include-workspace-root exec pnpx rimraf dist .rslib node_modules/.cache",
        "reset": "pnpm clean && pnpm reset:modules",
        "reset:modules": "pnpm -r --parallel --include-workspace-root exec pnpx rimraf node_modules pnpm-lock.yaml"
    },
    "devDependencies": {
        "@types/node": "26.6.5",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@workleap/typescript-configs": "5.0.0",
        "oxfmt": "0.75.0",
        "oxlint": "1.90.0",
        "oxlint-tsgolint": "7.0.2005",
        "syncpack": "15.3.3",
        "typescript": "7.0.2"
    }
}
